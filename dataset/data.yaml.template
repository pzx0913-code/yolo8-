# YOLO 车辆目标检测数据集配置模板
# 当你从 Roboflow 或开源平台下载完 YOLO 格式的数据集后，可按如下格式填写并保存为 dataset/data.yaml：

# 数据集根目录 (使用相对路径保证不同电脑与笔记本均可开箱即用)
path: dataset

# 训练集、验证集、测试集图片相对路径
train: images/train
val: images/val
test: images/test   # 可选

# 类别数量与名称示例
nc: 6
names:
  0: qiche          # 汽车 / 乘用车 (通用轿车/乘用车辆)
  1: suv            # 城市多用途 SUV
  2: bus            # 公交 / 大客车
  3: truck          # 货运卡车
  4: motorcycle     # 摩托车 / 两轮机动车
  5: van            # 厢式货车 / 面包车
